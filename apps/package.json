{
  "name": "next-convex-app",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "convex dev --start \"next dev\"",
    "dev:web": "next dev",
    "dev:convex": "convex dev",
    "convex:init": "convex dev --once",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare preview",
    "zip": "node ../scripts/zip.mjs",
    "deploy:worker": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.ts",
    "test:ui-leak": "node --test tests/ui-leakage.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm audit"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.104",
    "@base-ui/react": "^1.8.0",
    "@convex-dev/better-auth": "^0.12.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@opennextjs/cloudflare": "^1.20.16",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@rive-app/react-webgl2": "^4.34.2",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.11.6",
    "ai": "^7.0.101",
    "anser": "^2.3.5",
    "better-auth": "~1.6.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.45.0",
    "embla-carousel-react": "^8.6.0",
    "html2canvas-pro": "^2.6.4",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.46.0",
    "media-chrome": "^4.19.2",
    "motion": "^12.43.0",
    "nanoid": "^6.0.1",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-jsx-parser": "^2.4.1",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.7.0",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "wrangler": "^4.158.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10"
