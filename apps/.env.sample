# Next.js/local runtime. Copy these names to .env.local and keep real values
# uncommitted.

# Convex CLI manages these two values after `npm run convex:init`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Browser-safe HTTP Actions URL for the same deployment (ends in .convex.site).
NEXT_PUBLIC_CONVEX_SITE_URL=

# Public origin where the Next.js app is served (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentication methods shown by the Next.js app. Google is recommended but
# optional. Keep at least one method enabled.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
NEXT_PUBLIC_EMAIL_PASSWORD_AUTH_ENABLED=true

# Legacy test-only presentation gate. New projects should use
# NEXT_PUBLIC_EMAIL_PASSWORD_AUTH_ENABLED instead.
E2E_EMAIL_PASSWORD_AUTH_ENABLED=false

# Convex deployment runtime. Do not put these values in .env.local. Set them on
# the selected deployment with `npx convex env set NAME VALUE`.
# BETTER_AUTH_SECRET=
# SITE_URL=http://localhost:3000
# GOOGLE_AUTH_ENABLED=true
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# EMAIL_PASSWORD_AUTH_ENABLED=true
# E2E_EMAIL_PASSWORD_AUTH_ENABLED=false
